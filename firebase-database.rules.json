{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "publicProfiles": {
      "$uid": {
        ".read": "data.child('isPublic').val() === true || (auth != null && auth.uid === $uid)",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid','username','displayName','createdAt','updatedAt','isPublic']) && newData.child('uid').val() === $uid && newData.child('username').isString() && newData.child('username').val().matches(/^[a-z0-9_]{3,24}$/) && newData.child('displayName').isString() && newData.child('displayName').val().length <= 40 && (!newData.child('bio').exists() || newData.child('bio').val().length <= 180) && (!newData.child('allowTasteDiscovery').exists() || newData.child('allowTasteDiscovery').isBoolean())"
      }
    },
    "usernames": {
      ".read": true,
      "$username": {
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && (!newData.exists() || newData.val() === auth.uid)))",
        ".validate": "!newData.exists() || ($username.matches(/^[a-z0-9_]{3,24}$/) && newData.val() === auth.uid)"
      }
    },
    "watchlists": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "publicWatchlists": {
      "$uid": {
        ".read": "(root.child('publicProfiles').child($uid).child('isPublic').val() === true && root.child('publicProfiles').child($uid).child('showWatchlist').val() === true) || (auth != null && auth.uid === $uid)",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "publicRecent": {
      "$uid": {
        ".read": "(root.child('publicProfiles').child($uid).child('isPublic').val() === true && root.child('publicProfiles').child($uid).child('showRecentMovies').val() === true) || (auth != null && auth.uid === $uid)",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "following": {
      ".read": true,
      "$uid": {
        "$targetUid": { ".write": false }
      }
    },
    "followers": {
      ".read": true,
      "$targetUid": {
        "$followerUid": { ".write": false }
      }
    },
    "friendRequests": {
      "$recipientUid": {
        ".read": "auth != null && auth.uid === $recipientUid",
        "$senderUid": {
          ".write": "auth != null && $recipientUid !== $senderUid && ((auth.uid === $senderUid && !data.exists() && newData.exists() && !root.child('blocks').child($recipientUid).child($senderUid).exists() && !root.child('blocks').child($senderUid).child($recipientUid).exists() && !root.child('friendships').child($recipientUid).child($senderUid).exists() && !root.child('friendRequests').child($senderUid).child($recipientUid).exists()) || (data.exists() && !newData.exists() && (auth.uid === $senderUid || auth.uid === $recipientUid)))",
          ".validate": "!newData.exists() || (newData.child('uid').val() === $senderUid && newData.child('username').val() === root.child('publicProfiles').child($senderUid).child('username').val() && newData.child('displayName').val() === root.child('publicProfiles').child($senderUid).child('displayName').val() && newData.child('createdAt').isNumber())"
        }
      }
    },
    "sentFriendRequests": {
      "$senderUid": {
        ".read": "auth != null && auth.uid === $senderUid",
        "$recipientUid": {
          ".write": "auth != null && $recipientUid !== $senderUid && ((auth.uid === $senderUid && !data.exists() && newData.exists() && !root.child('blocks').child($recipientUid).child($senderUid).exists() && !root.child('blocks').child($senderUid).child($recipientUid).exists() && !root.child('friendships').child($senderUid).child($recipientUid).exists() && !root.child('friendRequests').child($senderUid).child($recipientUid).exists()) || (data.exists() && !newData.exists() && (auth.uid === $senderUid || auth.uid === $recipientUid)))",
          ".validate": "!newData.exists() || (newData.child('uid').val() === $recipientUid && newData.child('username').val() === root.child('publicProfiles').child($recipientUid).child('username').val() && newData.child('displayName').val() === root.child('publicProfiles').child($recipientUid).child('displayName').val() && newData.child('createdAt').isNumber())"
        }
      }
    },
    "friendships": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".write": "auth != null && $uid !== $friendUid && ((!data.exists() && newData.exists() && !root.child('blocks').child($uid).child($friendUid).exists() && !root.child('blocks').child($friendUid).child($uid).exists() && ((auth.uid === $uid && root.child('friendRequests').child($uid).child($friendUid).exists()) || (auth.uid === $friendUid && root.child('friendRequests').child($friendUid).child($uid).exists()))) || (data.exists() && !newData.exists() && (auth.uid === $uid || auth.uid === $friendUid)))",
          ".validate": "!newData.exists() || (newData.child('uid').val() === $friendUid && newData.child('username').val() === root.child('publicProfiles').child($friendUid).child('username').val() && newData.child('displayName').val() === root.child('publicProfiles').child($friendUid).child('displayName').val() && newData.child('createdAt').isNumber())"
        }
      }
    },
    "blocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$blockedUid": { ".write": "auth != null && auth.uid === $uid", ".validate": "!newData.exists() || newData.val() === true" }
      }
    },
    "presenceConnections": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('friendships').child($uid).child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid",
        "$connectionId": { ".validate": "!newData.exists() || newData.val() === true" }
      }
    },
    "presenceLastSeen": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('friendships').child($uid).child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || newData.isNumber()"
      }
    },
    "accountSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$sessionId": {
          ".validate": "!newData.exists() || (newData.child('id').val() === $sessionId && newData.child('startedAt').isNumber() && newData.child('device').isString() && newData.child('browser').isString() && newData.child('timezone').isString() && newData.child('locale').isString())"
        }
      }
    },
    "watchPartyInvites": {
      ".indexOn": ["recipientUid", "roomId", "expiresAt"],
      "$inviteId": {
        ".read": "auth != null && (data.child('inviterUid').val() === auth.uid || data.child('recipientUid').val() === auth.uid)",
        ".write": false
      }
    },
    "reviews": {
      ".read": true,
      "$movieSlug": {
        "$authorUid": {
          ".write": false
        }
      }
    },
    "reviewLikes": {
      ".read": true,
      "$movieSlug": {
        "$authorUid": {
          "$likerUid": { ".write": false }
        }
      }
    },
    "reviewReplies": {
      ".read": true,
      "$movieSlug": {
        "$reviewAuthorUid": {
          "$replyId": { ".write": false }
        }
      }
    },
    "activities": {
      "$uid": {
        ".read": "(root.child('publicProfiles').child($uid).child('isPublic').val() === true && root.child('publicProfiles').child($uid).child('showActivity').val() === true) || (auth != null && auth.uid === $uid)",
        "$activityId": { ".write": "auth != null && auth.uid === $uid", ".validate": "newData.child('actorUid').val() === $uid" }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$notificationId": {
          ".write": "auth != null && ((auth.uid === $uid && data.exists() && (!newData.exists() || (newData.child('id').val() === data.child('id').val() && newData.child('type').val() === data.child('type').val() && newData.child('actorUid').val() === data.child('actorUid').val() && newData.child('actorName').val() === data.child('actorName').val() && newData.child('actorUsername').val() === data.child('actorUsername').val() && newData.child('actorAvatar').val() === data.child('actorAvatar').val() && newData.child('movieSlug').val() === data.child('movieSlug').val() && newData.child('movieTitle').val() === data.child('movieTitle').val() && newData.child('reviewId').val() === data.child('reviewId').val() && newData.child('roomId').val() === data.child('roomId').val() && newData.child('expiresAt').val() === data.child('expiresAt').val() && newData.child('inviteId').val() === data.child('inviteId').val() && newData.child('eventId').val() === data.child('eventId').val() && newData.child('title').val() === data.child('title').val() && newData.child('body').val() === data.child('body').val() && newData.child('href').val() === data.child('href').val() && newData.child('severity').val() === data.child('severity').val() && newData.child('plan').val() === data.child('plan').val() && newData.child('code').val() === data.child('code').val() && newData.child('createdAt').val() === data.child('createdAt').val() && newData.child('read').val() === true))) || (!data.exists() && newData.child('actorUid').val() === auth.uid && ((newData.child('type').val() === 'friend_request' && root.child('friendRequests').child($uid).child(auth.uid).exists()) || (newData.child('type').val() === 'friend_accepted' && root.child('friendships').child($uid).child(auth.uid).exists()) || newData.child('type').val() === 'follow' || newData.child('type').val() === 'review_like' || newData.child('type').val() === 'review_reply'))) ",
          ".validate": "!newData.exists() || (newData.child('actorUid').isString() && newData.child('type').isString() && newData.child('createdAt').isNumber())"
        }
      }
    },
    "reports": {
      "$reportId": {
        ".read": false,
        ".write": false
      }
    },
    "monetization": {
      ".read": false,
      ".write": false,
      "auditLogs": { ".indexOn": ["createdAt", "status", "category", "targetUid"] },
      "transactionalEmailOutbox": { ".indexOn": ["status", "nextAttemptAt"] }
    },
    "analytics": {
      ".read": false,
      ".write": false,
      "playbackSessions": { ".indexOn": ["uid", "finalized", "lastHeartbeatAt", "startedAt"] }
    },
    "personalization": { ".read": false, ".write": false },
    "content": { ".read": false, ".write": false },
    "publicContent": { ".read": true, ".write": false },
    "community": { ".read": false, ".write": false },
    "publicCommunity": { ".read": true, ".write": false },
    "entitlementGrantStates": { ".read": false, ".write": false },
    "entitlementGrants": { ".read": false, ".write": false },
    "entitlementGrantEvents": { ".read": false, ".write": false },
    "entitlementRestrictions": { ".read": false, ".write": false },
    "entitlementMutationReceipts": { ".read": false, ".write": false },
    "githubStar": { ".read": false, ".write": false, "claims": { ".indexOn": ["status", "createdAt", "githubId", "uid"] } },
    "support": { ".read": false, ".write": false, "feedback": { ".indexOn": ["status", "createdAt", "uid"] } },
    ".read": false,
    ".write": false
  }
}
